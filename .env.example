# Copy to .env and fill in your own credentials. These are placeholders only.
# The application reads process variables and does not auto-load .env.
BOT_TOKEN=replace_with_telegram_bot_token
SOURCE_CHAT_ID=replace_with_source_channel_id
TARGET_CHAT_ID=replace_with_target_channel_id

DB_PATH=./data/messages.db
TIMEZONE=Asia/Shanghai
SUMMARY_INTERVAL_MINUTES=60
QUIET_START_HOUR=2
QUIET_END_HOUR=9
ALERT_THRESHOLD=3
ALERT_COOLDOWN_SECONDS=3600
# Fast alerts: 2 distinct KOLs in 180 seconds. No account cap per research round.

TWITTER_TOKEN=replace_with_x_data_api_token
TWITTER_API_BASE=https://ai.6551.io
FRONTRUN_API_KEY=

# DeepSeek V4.1 Flash via TeamoRouter. Both endpoints are required for this gateway.
DEEPSEEK_API_KEY=replace_with_compatible_gateway_key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.teamorouter.com/v1
DEEPSEEK_MESSAGES_URL=https://api.teamorouter.com/v1/messages

# Optional Grok gateway. Blank key disables this provider.
TEAMOROUTER_API_KEY=
TEAMOROUTER_BASE_URL=https://api.teamorouter.com/v1
TEAMOROUTER_MODEL_BASIC=grok-4.6
TEAMOROUTER_MODEL_DEEP=grok-4.6

# Optional original xAI fallback. Blank key disables this provider.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_BASIC=grok-4.3
XAI_MODEL_DEEP=grok-4.3

# Use a unique random service token in a real deployment.
ALPHA_API_TOKEN=replace_with_random_service_token
PORT=8080
# See SECURITY.md to generate password hashes; do not store a plaintext password.
ALPHA_WEB_AUTH=
ALPHA_WEB_DIR=./alpha-atlas/web
# Public access is opt-in. Set to 1 only when ready to publish the sanitized view.
ALPHA_PUBLIC_ENABLED=0
# For local development, replace this Docker path with ./showcase.
ALPHA_PUBLIC_DIR=/app/showcase
